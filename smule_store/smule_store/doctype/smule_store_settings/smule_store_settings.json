{
    "doctype": "DocType",
    "name": "Smule Store Settings",
    "module": "Smule Store",
    "issingle": 1,
    "istable": 0,
    "editable_grid": 0,
    "track_changes": 1,
    "field_order": [
        "storefront_section",
        "online_orders_enabled",
        "company",
        "selling_price_list",
        "pricing_section",
        "automatic_pricing_enabled",
        "material_cost_price_list",
        "markup_percentage",
        "custom_cookie_fixed_cost",
        "price_rounding_increment",
        "custom_cookie_item",
        "pickup_section",
        "pickup_address",
        "pickup_hours",
        "delivery_enabled",
        "delivery_fee",
        "delivery_fee_collection",
        "delivery_charge_item",
        "payment_section",
        "zarinpal_enabled",
        "zarinpal_merchant_id",
        "zarinpal_sandbox",
        "mode_of_payment",
        "payment_account",
        "setup_note"
    ],
    "fields": [
        {"fieldname": "storefront_section", "fieldtype": "Section Break", "label": "فروشگاه"},
        {"fieldname": "online_orders_enabled", "fieldtype": "Check", "label": "دریافت سفارش از سایت فعال باشد", "default": "0"},
        {"fieldname": "company", "fieldtype": "Link", "label": "شرکت فروشنده", "options": "Company", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "selling_price_list", "fieldtype": "Link", "label": "لیست قیمت فروش", "options": "Price List", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "pricing_section", "fieldtype": "Section Break", "label": "قانون قیمت‌گذاری خودکار", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "automatic_pricing_enabled", "fieldtype": "Check", "label": "قیمت‌گذاری خودکار بر اساس بهای واقعی فعال باشد", "default": "0", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "material_cost_price_list", "fieldtype": "Link", "label": "لیست بهای خرید مواد (ریال)", "options": "Price List", "depends_on": "eval:doc.online_orders_enabled && doc.automatic_pricing_enabled"},
        {"fieldname": "markup_percentage", "fieldtype": "Percent", "label": "درصد افزوده روی هزینه (Markup)", "depends_on": "eval:doc.online_orders_enabled && doc.automatic_pricing_enabled"},
        {"fieldname": "custom_cookie_fixed_cost", "fieldtype": "Currency", "label": "هزینهٔ ثابت ساخت و بسته‌بندی هر کوکی سفارشی (ریال)", "depends_on": "eval:doc.online_orders_enabled && doc.automatic_pricing_enabled"},
        {"fieldname": "price_rounding_increment", "fieldtype": "Currency", "label": "گام گردکردن رو به بالای قیمت (ریال)", "default": "1", "depends_on": "eval:doc.online_orders_enabled && doc.automatic_pricing_enabled"},
        {"fieldname": "custom_cookie_item", "fieldtype": "Link", "label": "کالای پایهٔ کوکی سفارشی", "options": "Item", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "pickup_section", "fieldtype": "Section Break", "label": "تحویل"},
        {"fieldname": "pickup_address", "fieldtype": "Small Text", "label": "نشانی تحویل حضوری"},
        {"fieldname": "pickup_hours", "fieldtype": "Small Text", "label": "ساعت تحویل حضوری"},
        {"fieldname": "delivery_enabled", "fieldtype": "Check", "label": "ارسال با اسنپ‌پیک فعال باشد", "default": "0"},
        {"fieldname": "delivery_fee_collection", "fieldtype": "Select", "label": "روش دریافت هزینهٔ پیک", "options": "\nپرداخت جداگانه به اسنپ‌پیک\nافزودن به مبلغ زرین‌پال", "depends_on": "eval:doc.delivery_enabled"},
        {"fieldname": "delivery_fee", "fieldtype": "Currency", "label": "هزینهٔ ثابت ارسال (ریال)", "default": "0", "depends_on": "eval:doc.delivery_enabled && doc.delivery_fee_collection=='افزودن به مبلغ زرین‌پال'"},
        {"fieldname": "delivery_charge_item", "fieldtype": "Link", "label": "کالای هزینهٔ ارسال در ERPNext", "options": "Item", "depends_on": "eval:doc.delivery_enabled && doc.delivery_fee_collection=='افزودن به مبلغ زرین‌پال'"},
        {"fieldname": "payment_section", "fieldtype": "Section Break", "label": "پرداخت"},
        {"fieldname": "zarinpal_enabled", "fieldtype": "Check", "label": "پرداخت زرین‌پال فعال باشد", "default": "0", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "zarinpal_merchant_id", "fieldtype": "Password", "label": "شناسهٔ پذیرندهٔ زرین‌پال", "depends_on": "eval:doc.zarinpal_enabled"},
        {"fieldname": "zarinpal_sandbox", "fieldtype": "Check", "label": "حالت آزمایشی زرین‌پال", "default": "1", "depends_on": "eval:doc.zarinpal_enabled"},
        {"fieldname": "mode_of_payment", "fieldtype": "Link", "label": "روش پرداخت در ERPNext", "options": "Mode of Payment", "depends_on": "eval:doc.zarinpal_enabled"},
        {"fieldname": "payment_account", "fieldtype": "Link", "label": "حساب بانکی دریافت وجه در ERPNext", "options": "Account", "depends_on": "eval:doc.zarinpal_enabled"},
        {"fieldname": "setup_note", "fieldtype": "HTML", "options": "<div dir='rtl'><p>فروش آنلاین فقط پس از تکمیل شرکت، لیست قیمت‌ها، قانون قیمت‌گذاری، روش تحویل، حساب بانکی، روش پرداخت و شناسهٔ پذیرنده فعال می‌شود. شناسهٔ پذیرنده در فیلد رمزنگاری‌شده ذخیره می‌شود؛ آن را در چت یا کد سایت وارد نکنید. حالت آزمایشی به‌صورت پیش‌فرض روشن است و برای دریافت پول واقعی باید پس از آزمون، آن را آگاهانه خاموش کنید.</p><p><strong>قانون قیمت‌گذاری:</strong> قیمت کوکی آماده از بهای تمام‌شدهٔ BOM پیش‌فرضِ فعال و ثبت‌شده در ERPNext گرفته می‌شود؛ بسته‌بندی را در BOM بیاورید. قیمت کوکی سفارشی از (گرم خمیر و افزودنی × بهای خرید هر گرم) به‌علاوهٔ هزینهٔ ثابت ساخت/بسته‌بندی محاسبه می‌شود. سپس درصد افزوده روی هزینه اعمال و مبلغ رو به بالا گرد می‌شود. درصد افزوده با حاشیهٔ سود یکی نیست. برای اجزای کوکی سفارشی، بهای خرید هر خمیر و افزودنیِ تأییدشده را با واحد «Gram» در لیست خرید ERPNext ثبت کنید. پس از تغییر بهای مواد، هزینهٔ BOM را تازه کنید یا به‌روزرسانی خودکار هزینهٔ BOM را در تنظیمات تولید ERPNext فعال کنید. BOMها و دستورهای نمونه یا بدون بهای کامل، قابل سفارش نهایی نیستند؛ هزینه‌های واقعی و تنظیمات قیمت باید پیش از فعال‌کردن فروش تکمیل شوند. سفارش فروش، نرخ محاسبه‌شده و مبنای آن را ثبت می‌کند؛ نرخ نمونه در فروش استفاده نمی‌شود. ارز لیست‌های خرید و فروش و شرکت باید IRR باشد.</p><p>ارسال کرج با اسنپ‌پیک است. پیش از فعال‌کردن ارسال، سیاست هزینه را انتخاب کنید: پرداخت جدا به پیک، یا مبلغ ثابت همراه سفارش آنلاین. برای حالت دوم، کالای هزینهٔ ارسال را به ERPNext وصل کنید. نشانی و ساعت تحویل حضوری نیز باید کامل باشد.</p></div>"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1},
        {"role": "Sales Manager", "read": 1, "write": 1}
    ]
}
