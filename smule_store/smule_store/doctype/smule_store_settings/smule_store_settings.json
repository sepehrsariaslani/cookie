{
    "doctype": "DocType",
    "name": "Smule Store Settings",
    "module": "Smule Store",
    "issingle": 1,
    "istable": 0,
    "editable_grid": 0,
    "track_changes": 1,
    "field_order": [
        "storefront_section",
        "online_orders_enabled",
        "company",
        "selling_price_list",
        "custom_cookie_item",
        "pickup_section",
        "pickup_address",
        "pickup_hours",
        "delivery_enabled",
        "delivery_fee",
        "payment_section",
        "payment_gateway",
        "setup_note"
    ],
    "fields": [
        {"fieldname": "storefront_section", "fieldtype": "Section Break", "label": "فروشگاه"},
        {"fieldname": "online_orders_enabled", "fieldtype": "Check", "label": "دریافت سفارش از سایت فعال باشد", "default": "0"},
        {"fieldname": "company", "fieldtype": "Link", "label": "شرکت فروشنده", "options": "Company", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "selling_price_list", "fieldtype": "Link", "label": "لیست قیمت فروش", "options": "Price List", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "custom_cookie_item", "fieldtype": "Link", "label": "کالای پایهٔ کوکی سفارشی", "options": "Item", "depends_on": "eval:doc.online_orders_enabled"},
        {"fieldname": "pickup_section", "fieldtype": "Section Break", "label": "تحویل"},
        {"fieldname": "pickup_address", "fieldtype": "Small Text", "label": "نشانی تحویل حضوری"},
        {"fieldname": "pickup_hours", "fieldtype": "Small Text", "label": "ساعت تحویل حضوری"},
        {"fieldname": "delivery_enabled", "fieldtype": "Check", "label": "ارسال فعال باشد", "default": "0"},
        {"fieldname": "delivery_fee", "fieldtype": "Currency", "label": "هزینهٔ پایهٔ ارسال", "default": "0", "depends_on": "eval:doc.delivery_enabled"},
        {"fieldname": "payment_section", "fieldtype": "Section Break", "label": "پرداخت"},
        {"fieldname": "payment_gateway", "fieldtype": "Data", "label": "درگاه پرداخت (پس از انتخاب فروشگاه)"},
        {"fieldname": "setup_note", "fieldtype": "HTML", "options": "<div dir='rtl'><p>تا زمانی که شرکت، کالاها، قیمت‌ها، نشانی تحویل و درگاه تأیید نشده‌اند، سفارش‌گیری آنلاین خاموش می‌ماند. سفارش‌های سایت در ERPNext ثبت می‌شوند و پرداخت خودکار تا راه‌اندازی امن زرین‌پال انجام نمی‌شود.</p><p><strong>قیمت کوکی سفارشی:</strong> برای هر خمیر و افزودنیِ تأییدشده، واحد پایهٔ کالا را گرم قرار دهید و نرخ فروش همان کالا را با واحد «Gram» در لیست قیمت فروش وارد کنید. قیمت کوکی از جمعِ (گرم خمیر × نرخ هر گرم) و (گرم هر افزودنی × نرخ هر گرم) به دست می‌آید. خمیر یا افزودنیِ نمونه یا بدون نرخ، قیمت قطعی نمی‌گیرد و قابل ثبت به‌عنوان سفارش نهایی نیست. قیمت محصولات آماده از Item Price همان کالا خوانده می‌شود.</p><p>محدودهٔ ارسال اعلام‌شده: کرج، با اسنپ‌پیک. هزینهٔ پیک هنوز وارد جمع سفارش نشده؛ روش محاسبه و دریافت آن باید پیش از فعال‌کردن فروش تعیین شود.</p></div>"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1},
        {"role": "Sales Manager", "read": 1, "write": 1}
    ]
}
